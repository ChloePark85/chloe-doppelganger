ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# NeuroSync Configuration
NEUROSYNC_MODEL_PATH=./models/neurosync.onnx

# Vector DB Configuration
VECTOR_DB_PATH=./data/vector_store
